{
  "description": "myTradingAlpha lightweight harness guards, destructive-command deny guard, and measured lifecycle telemetry.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import pathlib,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); subprocess.run([sys.executable,str(r/'scripts'/'codex_hook_guard.py'),'session-start'], check=True)\"",
            "commandWindows": "python -c \"import pathlib,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); subprocess.run([sys.executable,str(r/'scripts'/'codex_hook_guard.py'),'session-start'], check=True)\"",
            "timeout": 15,
            "async": false,
            "statusMessage": "Checking myTradingAlpha Codex harness"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_pretool_guard.py\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); runpy.run_path(str(r/'scripts'/'codex_pretool_guard.py'), run_name='__main__')\"",
            "timeout": 5,
            "async": false,
            "statusMessage": "Checking destructive Bash command guard"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_telemetry_hook.py\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); runpy.run_path(str(r/'scripts'/'codex_telemetry_hook.py'), run_name='__main__')\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_telemetry_hook.py\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); runpy.run_path(str(r/'scripts'/'codex_telemetry_hook.py'), run_name='__main__')\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_telemetry_hook.py\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); runpy.run_path(str(r/'scripts'/'codex_telemetry_hook.py'), run_name='__main__')\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex_telemetry_hook.py\"",
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); runpy.run_path(str(r/'scripts'/'codex_telemetry_hook.py'), run_name='__main__')\"",
            "timeout": 3,
            "async": false,
            "statusMessage": "Cleaning Codex telemetry runtime state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import pathlib,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); subprocess.run([sys.executable,str(r/'scripts'/'codex_hook_guard.py'),'stop'], check=True)\"",
            "commandWindows": "python -c \"import pathlib,subprocess,sys; r=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'], text=True).strip()); subprocess.run([sys.executable,str(r/'scripts'/'codex_hook_guard.py'),'stop'], check=True)\"",
            "timeout": 15,
            "async": false,
            "statusMessage": "Checking myTradingAlpha stop guard"
          }
        ]
      }
    ]
  }
}
