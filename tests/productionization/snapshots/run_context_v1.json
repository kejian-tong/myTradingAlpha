{
  "$defs": {
    "Mode": {
      "description": "Execution/replay modes with stable wire values.",
      "enum": [
        "historical",
        "forward_paper",
        "live_pilot"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable, versioned context delimiting one production run.",
  "properties": {
    "base_currency": {
      "default": "USD",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Base Currency",
      "type": "string"
    },
    "bundle_hash": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Bundle Hash",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Bundle Id",
      "type": "string"
    },
    "calendar_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Calendar Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "earliest_execution_time": {
      "format": "date-time",
      "title": "Earliest Execution Time",
      "type": "string"
    },
    "knowledge_cutoff": {
      "format": "date-time",
      "title": "Knowledge Cutoff",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "variant_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$",
      "title": "Variant Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "variant_id",
    "decision_time",
    "knowledge_cutoff",
    "earliest_execution_time",
    "bundle_id",
    "bundle_hash",
    "calendar_id"
  ],
  "title": "RunContext",
  "type": "object"
}
